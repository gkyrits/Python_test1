# systemd unit for sensor_server.py
# install:
#   sudo cp sensor_server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sensor_server
# log:
#   journalctl -u sensor_server -f

[Unit]
Description=Weather and sensors logger for raspi_play
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gkyr
WorkingDirectory=/home/gkyr/Work/Python_test1/weather_time
ExecStart=/usr/bin/python3 -u sensor_server.py --no-cli
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
